@using IMS.CoreBusiness
@using IMS.UseCase.Inventories.Interfaces

@inject IViewInventoriesByNameUseCase ViewInventoriesByNameUseCase;
<div class="container py-4">

    <!-- Row 1 -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Search..."
                       aria-label="Search">
                    <button class="btn btn-primary" type="button">
                    Search
                    </button>
                </div>
            </div>
        </div>

    <!-- Row 2 -->
        <div class="row">
            <div class="col-12">
                <div class="border rounded p-4" style="min-height:300px;">
                @if (inventories is not null && inventories.Count > 0)
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                <th>Id</th>
                                <th>Name</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var inventory in inventories)
                                {
                                <InventoryListItemComponent Inventory="inventory"></InventoryListItemComponent>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

    </div>

@code {
    private List<Inventory>? inventories;
    protected override async Task OnInitializedAsync()
        {
        inventories = (await ViewInventoriesByNameUseCase.ExecuteAsync()).ToList();
        }
    }
